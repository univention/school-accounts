{
  "dependencies": {
    "@univention/univention-veb": "^0.0.68",
    "i18next": "^26.3.1",
    "i18next-vue": "^5.4.0",
    "pinia": "^3.0.4",
    "stylus": "^0.64.0",
    "vue": "^3.5.38",
    "vue-router": "^4.4.5"
  },
  "devDependencies": {
    "@playwright/test": "1.60.0",
    "@rushstack/eslint-patch": "^1.16.1",
    "@tsconfig/node18": "^2.0.1",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^18.19.130",
    "@types/uuid": "^9.0.8",
    "@vitejs/plugin-vue": "^4.6.2",
    "@vue/eslint-config-prettier": "^9.0.0",
    "@vue/eslint-config-typescript": "^13.0.0",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.4.0",
    "dotenv": "^16.6.1",
    "eslint": "^8.57.1",
    "eslint-plugin-vue": "^9.33.0",
    "jsdom": "^22.1.0",
    "npm-run-all": "^4.1.5",
    "playwright-i18next-fixture": "^1.0.0",
    "prettier": "^3.8.4",
    "typescript": "~5.4.5",
    "vite": "^4.3.9",
    "vite-plugin-rewrite-all": "^1.0.1",
    "vitest": "^0.32.4",
    "vue-tsc": "^1.8.27"
  },
  "name": "user-management-ui",
  "packageManager": "yarn@1.22.19",
  "private": true,
  "resolutions": {
    "strip-ansi": "6.0.1"
  },
  "scripts": {
    "build": "run-p type-check build-only",
    "build-only": "vite build",
    "dev": "vite --host 0.0.0.0",
    "format": "prettier --write src/",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore --max-warnings=0",
    "preview": "yarn build && vite preview",
    "test:e2e": "playwright test",
    "test:e2e:setup": "playwright install",
    "type-check": "vue-tsc --noEmit -p tsconfig.vitest.json --composite false"
  },
  "version": "1.0.0"
}
