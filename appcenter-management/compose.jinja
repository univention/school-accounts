version: '3.1'
services:
  user-management:
    image: {{ IMAGE_TAG }}
    security_opt:
      - seccomp:/etc/docker/seccomp-systemd.json
    restart: unless-stopped
    volumes:
      - /etc/ssl/certs:/etc/ssl/certs:ro
    environment:
      REQUESTS_CA_BUNDLE: /etc/ssl/certs/ca-certificates.crt
      SSL_CERT_FILE: /etc/ssl/certs/ca-certificates.crt
      USER_MANAGEMENT__API_PREFIX: "/univention/ucsschool/user-management/bff"
      USER_MANAGEMENT__FRONTEND_PREFIX: "/univention/ucsschool/user-management/ui"
      USER_MANAGEMENT__CORS__ALLOWED_ORIGINS: "*"
      USER_MANAGEMENT__ADAPTER__USERS_PERSISTENCE: "user_management_bff.adapters.users:KelvinUsersPersistenceAdapter"
      USER_MANAGEMENT__ADAPTER__SCHOOLS_PERSISTENCE: "user_management_bff.adapters.schools:KelvinSchoolsPersistenceAdapter"
      USER_MANAGEMENT__ADAPTER__SCHOOL_CLASSES_PERSISTENCE: "user_management_bff.adapters.school_classes:KelvinSchoolClassesPersistenceAdapter"
      USER_MANAGEMENT__ADAPTER__WORK_GROUPS_PERSISTENCE: "user_management_bff.adapters.work_groups:KelvinWorkGroupsPersistenceAdapter"
      USER_MANAGEMENT__ADAPTER__PERMISSIONS: "user_management_bff.adapters.permissions:GuardianPermissionsAdapter"
      KELVIN_PERSISTENCE_ADAPTER__USERNAME_FILE: /run/secrets/machine.user
      KELVIN_PERSISTENCE_ADAPTER__PASSWORD_FILE: /run/secrets/machine.secret
      KELVIN_PERSISTENCE_ADAPTER__URL: @!@
ucr = configRegistry
kelvin_url = ucr.get(
    'ucsschool-user-management/kelvin/url',
    f"{ucr.get('hostname')}.{ucr.get('domainname')}",
)
print(kelvin_url, end='')@!@
      USER_MANAGEMENT__ADAPTER__AUTHENTICATION: "user_management_bff.adapters.authentication:CookieSessionAuthenticationAdapter"
      USER_MANAGEMENT__ADAPTER__SESSION_STORE: "user_management_bff.adapters.session_store:InMemorySessionStoreAdapter"
      COOKIE_SESSION_AUTHENTICATION_ADAPTER__CLIENT_ID: "ucsschool-user-management-ui"
      COOKIE_SESSION_AUTHENTICATION_ADAPTER__IDENTIFIER_CLAIM: "uid"
      # TODO(appcenter): provision this secret file (e.g. a join/entrypoint step
      # writing a persistent random value). The same secret signs the
      # authenticated session cookie and the transient OAuth-state cookie.
      COOKIE_SESSION_AUTHENTICATION_ADAPTER__COOKIE_SECRET_FILE: "/var/lib/univention-appcenter/apps/ucsschool-user-management/conf/session.secret"
      USER_MANAGEMENT__SESSION_SECRET_FILE: "/var/lib/univention-appcenter/apps/ucsschool-user-management/conf/session.secret"
@!@
ucr = configRegistry
keycloak_url = ucr.get('guardian-management-ui/oauth/keycloak-uri')
if not keycloak_url:
    keycloak_url = ucr.get('keycloak/server/sso/fqdn', f"ucs-sso-ng.{ucr.get('domainname')}")
if not keycloak_url.startswith('http'):
    keycloak_url = f'https://{keycloak_url}'
well_known_url = f"{keycloak_url}/realms/ucs/.well-known/openid-configuration"
app_base_url = f"https://{ucr.get('hostname')}.{ucr.get('domainname')}/univention/ucsschool/user-management/ui"
print(f"      COOKIE_SESSION_AUTHENTICATION_ADAPTER__WELL_KNOWN_URL: {well_known_url}")
print(f"      COOKIE_SESSION_AUTHENTICATION_ADAPTER__REDIRECT_URL: {app_base_url}/auth/callback")
print(f"      COOKIE_SESSION_AUTHENTICATION_ADAPTER__POST_LOGOUT_REDIRECT_URL: {app_base_url}")
print(f"      GUARDIAN_PERMISSIONS_ADAPTER__OAUTH2_WELL_KNOWN_URL: {well_known_url}", end='')@!@
      GUARDIAN_PERMISSIONS_ADAPTER__CLIENT_ID: "ucsschool-user-management-bff"
      GUARDIAN_PERMISSIONS_ADAPTER__CLIENT_SECRET_FILE: "/run/secrets/client.secret"
      GUARDIAN_PERMISSIONS_ADAPTER__GUARDIAN_URL: @!@
ucr = configRegistry
api_url = 'http://cerbos:3592'
print(api_url, end='')@!@
      USER_MANAGEMENT__LOGGING__FORMAT: @%@ucsschool-user-management/logging/format@%@
      USER_MANAGEMENT__LOGGING__LEVEL: @%@ucsschool-user-management/logging/level@%@
      USER_MANAGEMENT__LOGGING__STRUCTURED: "@%@ucsschool-user-management/logging/structured@%@"
    networks:
      - guardian

networks:
  guardian:
    external: true
