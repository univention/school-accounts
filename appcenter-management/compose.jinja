version: '3.1'
services:
  user-management:
    image: {{ IMAGE_TAG }}
    security_opt:
      - seccomp:/etc/docker/seccomp-systemd.json
    restart: unless-stopped
    volumes:
      - /etc/ssl/certs:/etc/ssl/certs:ro
    environment:
      REQUESTS_CA_BUNDLE: /etc/ssl/certs/ca-certificates.crt
      SSL_CERT_FILE: /etc/ssl/certs/ca-certificates.crt
      USER_MANAGEMENT__API_PREFIX: "/univention/ucsschool/user-management/bff"
      USER_MANAGEMENT__FRONTEND_PREFIX: "/univention/ucsschool/user-management/ui"
      USER_MANAGEMENT__CORS__ALLOWED_ORIGINS: "*"
      USER_MANAGEMENT__ADAPTER__USERS_REPRESENTATION: "user_management_bff.adapters.api:FastAPIUsersRepresentationAdapter"
      USER_MANAGEMENT__ADAPTER__USERS_PERSISTENCE: "user_management_bff.adapters.users:KelvinUsersPersistenceAdapter"
      USER_MANAGEMENT__ADAPTER__SCHOOLS_REPRESENTATION: "user_management_bff.adapters.api:FastAPISchoolsRepresentationAdapter"
      USER_MANAGEMENT__ADAPTER__SCHOOLS_PERSISTENCE: "user_management_bff.adapters.schools:KelvinSchoolsPersistenceAdapter"
      USER_MANAGEMENT__ADAPTER__SCHOOL_CLASSES_PERSISTENCE: "user_management_bff.adapters.school_classes:KelvinSchoolClassesPersistenceAdapter"
      USER_MANAGEMENT__ADAPTER__SCHOOL_CLASSES_REPRESENTATION: "user_management_bff.adapters.api:FastAPISchoolClassesRepresentationAdapter"
      USER_MANAGEMENT__ADAPTER__WORK_GROUPS_PERSISTENCE: "user_management_bff.adapters.work_groups:KelvinWorkGroupsPersistenceAdapter"
      USER_MANAGEMENT__ADAPTER__WORK_GROUPS_REPRESENTATION: "user_management_bff.adapters.api:FastAPIWorkGroupsRepresentationAdapter"
      USER_MANAGEMENT__ADAPTER__ADD_CONFIG_REPRESENTATION: "user_management_bff.adapters.api:FastAPIAddConfigRepresentationAdapter"
      USER_MANAGEMENT__ADAPTER__EDIT_CONFIG_REPRESENTATION: "user_management_bff.adapters.api:FastAPIEditConfigRepresentationAdapter"
      USER_MANAGEMENT__ADAPTER__LIST_CONFIG_REPRESENTATION: "user_management_bff.adapters.api:FastAPIListConfigRepresentationAdapter"
      USER_MANAGEMENT__ADAPTER__PERMISSIONS: "user_management_bff.adapters.permissions:GuardianPermissionsAdapter"
      KELVIN_PERSISTENCE_ADAPTER__USERNAME_FILE: /etc/machine.user
      KELVIN_PERSISTENCE_ADAPTER__PASSWORD_FILE: /etc/machine.secret
      KELVIN_PERSISTENCE_ADAPTER__URL: @!@
ucr = configRegistry
kelvin_url = ucr.get(
    'ucsschool-user-management/kelvin/url',
    f"{ucr.get('hostname')}.{ucr.get('domainname')}",
)
print(kelvin_url, end='')@!@
      USER_MANAGEMENT__ADAPTER__AUTHENTICATION: "user_management_bff.adapters.authentication:Oauth2FastAPIAuthenticationAdapter"
@!@
ucr = configRegistry
keycloak_url = ucr.get('guardian-management-ui/oauth/keycloak-uri')
if not keycloak_url:
    keycloak_url = ucr.get('keycloak/server/sso/fqdn', f"ucs-sso-ng.{ucr.get('domainname')}")
if not keycloak_url.startswith('http'):
    keycloak_url = f'https://{keycloak_url}'
well_known_url = f"{keycloak_url}/realms/ucs/.well-known/openid-configuration"
print(f"      VITE__KEYCLOAK_AUTHENTICATION_ADAPTER__SSO_URI: {keycloak_url}")
print(f"      OAUTH2_FASTAPI_AUTHENTICATION_ADAPTER__WELL_KNOWN_URL: {well_known_url}")
print(f"      GUARDIAN_PERMISSIONS_ADAPTER__OAUTH2_WELL_KNOWN_URL: {well_known_url}", end='')@!@
      OAUTH2_FASTAPI_AUTHENTICATION_ADAPTER__AUDIENCE: "ucsschool-user-management"
      OAUTH2_FASTAPI_AUTHENTICATION_ADAPTER__IDENTIFIER_CLAIM: "uid"
      GUARDIAN_PERMISSIONS_ADAPTER__CLIENT_ID: "ucsschool-user-management-bff"
      GUARDIAN_PERMISSIONS_ADAPTER__CLIENT_SECRET_FILE: "/var/lib/univention-appcenter/apps/ucsschool-user-management/conf/client.secret"
      GUARDIAN_PERMISSIONS_ADAPTER__GUARDIAN_URL: @!@
ucr = configRegistry
api_url = ucr.get(
    'ucsschool-user-management/guardian/url',
    f"https://{ucr.get('hostname')}.{ucr.get('domainname')}/guardian/authorization",
)
print(api_url, end='')@!@
      USER_MANAGEMENT__LOGGING__FORMAT: @%@ucsschool-user-management/logging/format@%@
      USER_MANAGEMENT__LOGGING__LEVEL: @%@ucsschool-user-management/logging/level@%@
      USER_MANAGEMENT__LOGGING__STRUCTURED: "@%@ucsschool-user-management/logging/structured@%@"

      VITE__USER_MANAGEMENT_UI__ADAPTER__AUTHENTICATION_PORT: keycloak
      VITE__USER_MANAGEMENT_UI__ADAPTER__DATA_PORT: api
      VITE__API_DATA_ADAPTER__URI: /univention/ucsschool/user-management/bff
      VITE__KEYCLOAK_AUTHENTICATION_ADAPTER__REALM: ucs
      VITE__KEYCLOAK_AUTHENTICATION_ADAPTER__CLIENT_ID: ucsschool-user-management-ui
