#!/bin/bash
# SPDX-FileCopyrightText: 2024-2026 Univention GmbH
# SPDX-License-Identifier: AGPL-3.0-only
# This file is used to autogenerate the preinst script during the authz_app_to_test_appcenter job.
# This is necessary for installing some files on the host system.

set -e

APP_ID="ucsschool-user-management"
APP_DIR="/var/lib/univention-appcenter/apps/$APP_ID"
SCRIPTS_DIR="$APP_DIR/scripts"
CONDITIONS_DIR="$SCRIPTS_DIR/conditions"
CONF_DIR="$APP_DIR/conf"

mkdir -p $SCRIPTS_DIR
mkdir -p $CONF_DIR
mkdir -p $CONDITIONS_DIR

if [ ! -f "$CONF_DIR/client.secret" ]; then
    echo "CHANGE ME" > "$CONF_DIR/client.secret"
    chmod 600 "$CONF_DIR/client.secret"
fi

configure_guardian_script_path=$SCRIPTS_DIR/configure_guardian.py
cat <<%EOF >"$configure_guardian_script_path"
%CONFIGURE-GUARDIAN%
%EOF
chmod +x $configure_guardian_script_path

action_is_creation_info_path=$CONDITIONS_DIR/action_is_creation.json
cat <<%EOF >"$action_is_creation_info_path"
%ACTION_IS_CREATION_INFO%
%EOF
chmod 644 $action_is_creation_info_path

action_is_creation_rego_path=$CONDITIONS_DIR/action_is_creation.rego
cat <<%EOF >"$action_is_creation_rego_path"
%ACTION_IS_CREATION_REGO%
%EOF
chmod 644 $action_is_creation_rego_path

actor_is_in_group_info_path=$CONDITIONS_DIR/actor_is_in_group.json
cat <<%EOF >"$actor_is_in_group_info_path"
%ACTOR_IS_IN_GROUP_INFO%
%EOF
chmod 644 $actor_is_in_group_info_path

actor_is_in_group_rego_path=$CONDITIONS_DIR/actor_is_in_group.rego
cat <<%EOF >"$actor_is_in_group_rego_path"
%ACTOR_IS_IN_GROUP_REGO%
%EOF
chmod 644 $actor_is_in_group_rego_path

target_will_be_in_same_school_only_info_path=$CONDITIONS_DIR/target_will_be_in_same_school_only.json
cat <<%EOF >"$target_will_be_in_same_school_only_info_path"
%TARGET_WILL_BE_IN_SAME_SCHOOL_ONLY_INFO%
%EOF
chmod 644 $target_will_be_in_same_school_only_info_path

target_will_be_in_same_school_only_rego_path=$CONDITIONS_DIR/target_will_be_in_same_school_only.rego
cat <<%EOF >"$target_will_be_in_same_school_only_rego_path"
%TARGET_WILL_BE_IN_SAME_SCHOOL_ONLY_REGO%
%EOF
chmod 644 $target_will_be_in_same_school_only_rego_path

target_will_have_allowed_roles_only_info_path=$CONDITIONS_DIR/target_will_have_allowed_roles_only.json
cat <<%EOF >"$target_will_have_allowed_roles_only_info_path"
%TARGET_WILL_HAVE_ALLOWED_ROLES_ONLY_INFO%
%EOF
chmod 644 $target_will_have_allowed_roles_only_info_path

target_will_have_allowed_roles_only_rego_path=$CONDITIONS_DIR/target_will_have_allowed_roles_only.rego
cat <<%EOF >"$target_will_have_allowed_roles_only_rego_path"
%TARGET_WILL_HAVE_ALLOWED_ROLES_ONLY_REGO%
%EOF
chmod 644 $target_will_have_allowed_roles_only_rego_path

target_shares_school_class_in_school_context_info_path=$CONDITIONS_DIR/target_shares_school_class_in_school_context.json
cat <<%EOF >"$target_shares_school_class_in_school_context_info_path"
%TARGET_SHARES_SCHOOL_CLASS_IN_SCHOOL_CONTEXT_INFO%
%EOF
chmod 644 $target_shares_school_class_in_school_context_info_path

target_shares_school_class_in_school_context_rego_path=$CONDITIONS_DIR/target_shares_school_class_in_school_context.rego
cat <<%EOF >"$target_shares_school_class_in_school_context_rego_path"
%TARGET_SHARES_SCHOOL_CLASS_IN_SCHOOL_CONTEXT_REGO%
%EOF
chmod 644 $target_shares_school_class_in_school_context_rego_path

# ucsschool-user-management-ui keycloak client config
ucsschool_user_management_ui_client_path="$CONF_DIR/ucsschool-user-management_client_ui.json"
echo "Installing Keycloak client config for the UI"
	cat <<%EOF >"$ucsschool_user_management_ui_client_path"
%UI_CLIENT%
%EOF
chmod 644 "$ucsschool_user_management_ui_client_path"

# ucsschool-user-management-bff keycloak client config
ucsschool_user_management_bff_client_path="$CONF_DIR/ucsschool-user-management_client_bff.json"
echo "Installing Keycloak client config for the BFF"
	cat <<%EOF >"$ucsschool_user_management_bff_client_path"
%BFF_CLIENT%
%EOF
chmod 644 "$ucsschool_user_management_bff_client_path"
