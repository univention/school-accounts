# This file is used to autogenerate the preinst script during the authz_app_to_test_appcenter job.
# This is necessary for installing some files on the host system.

set -e

APP_ID="ucsschool-accounts"
APP_DIR="/var/lib/univention-appcenter/apps/$APP_ID"
SCRIPTS_DIR="$APP_DIR/scripts"
POLICIES_DIR="$SCRIPTS_DIR/policies"
CONF_DIR="$APP_DIR/conf"

mkdir -p $SCRIPTS_DIR
mkdir -p $CONF_DIR

# Cerbos policy bundle; inst tars this dir and registers it in LDAP via
# ucs_registerLDAPExtension for a listener on Cerbos hosts to install. The
# blocks below are generated by generate-preinst from every non-test *.yaml
# file in files/policies/, so a new policy file ships automatically
# without needing to be wired in here by name.
/%POLICIES%/

# Keys the encrypted session cookie and signs the OAuth-state cookie. Reusing
# an existing file is what keeps sessions valid across an app update.
SESSION_SECRET_FILE="$CONF_DIR/session.secret"
if [ -s "$SESSION_SECRET_FILE" ]; then
	echo "Using existing session secret in $SESSION_SECRET_FILE"
else
	echo "Generating session secret in $SESSION_SECRET_FILE"
	# The container reads it via /run/secrets (see entrypoint.d/10-copy-secrets.sh),
	touch "$SESSION_SECRET_FILE"
	chmod 640 "$SESSION_SECRET_FILE"
	# prevent "unable to write 'random state'" because $HOME is not set
	export RANDFILE=/.rnd
	openssl rand -hex 32 > "$SESSION_SECRET_FILE"
fi

# Authenticates the app as the confidential ucsschool-accounts-ui client at
# Keycloak's token endpoint. Generated here rather than in the join script because
# the container copies it out of this directory at boot, which happens first.
# Only a first installation in the domain keeps this value: the client belongs to
# the shared realm, so the join script replaces the file with the secret Keycloak
# already holds whenever the client is registered.
CLIENT_SECRET_FILE="$CONF_DIR/client.secret"
if [ -s "$CLIENT_SECRET_FILE" ]; then
	echo "Using existing client secret in $CLIENT_SECRET_FILE"
else
	echo "Generating client secret in $CLIENT_SECRET_FILE"
	touch "$CLIENT_SECRET_FILE"
	chmod 640 "$CLIENT_SECRET_FILE"
	export RANDFILE=/.rnd
	openssl rand -hex 32 > "$CLIENT_SECRET_FILE"
fi

# ucsschool-accounts-ui keycloak client config
ucsschool_accounts_ui_client_path="$CONF_DIR/ucsschool-accounts_client_ui.json"
echo "Installing Keycloak client config for the UI"
	cat <<'%EOF' >"$ucsschool_accounts_ui_client_path"
%UI_CLIENT%
%EOF
chmod 644 "$ucsschool_accounts_ui_client_path"
