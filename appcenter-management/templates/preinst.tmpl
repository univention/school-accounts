set -e

APP_ID="ucsschool-user-management"
APP_DIR="/var/lib/univention-appcenter/apps/$APP_ID"
SCRIPTS_DIR="$APP_DIR/scripts"

mkdir -p $SCRIPTS_DIR
configure_guardian_script_path=$SCRIPTS_DIR/configure_guardian.py
cat <<%EOF >"$configure_guardian_script_path"
%CONFIGURE-GUARDIAN%
%EOF
chmod +x $configure_guardian_script_path
