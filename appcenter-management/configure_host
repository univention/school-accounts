APP_ID="ucsschool-accounts"

action=$1

if [ "$action" = "settings" ]; then
  univention-app reinitialize ucsschool-accounts
fi

if [ "$action" = "remove" ]; then
    eval "$(ucr shell hostname domainname)"
    machine_username="${hostname:?}$"
    machine_pw="$(cat /etc/machine.secret)"
    keycloak_url=$(ucr get keycloak/server/sso/fqdn)

    if [ -z "$keycloak_url" ]
        then
        keycloak_url="https://ucs-sso-ng.${domainname:?}"
    elif ! [[ $keycloak_url == http* ]]
        then
        keycloak_url="https://$keycloak_url"
    fi
    univention-app shell "$APP_ID" /venv/bin/keycloak-provisioning \
          --username "$machine_username" \
          --password "$machine_pw" \
          --url "$keycloak_url" \
          --realm ucs \
          --user-realm master \
          clients modify ucsschool-accounts-ui \
          --remove-redirect-urls "https://${hostname:?}.${domainname:?}/univention/ucsschool/ucsschool-accounts/*"
fi
