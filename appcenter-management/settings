[ucsschool-user-management/kelvin/url]
Type = String
Description = The hostname of the Kelvin REST API for data queries. If not set, the url is generated from hostname and domainname.
Description[de] = Der Hostname der Kelvin REST API, welche zum Abrufen von Daten genutzt wird. Wenn nicht gesetzt, wird die URL aus Hostname und Domainname generiert.
Group = Kelvin
Scope = outside
Show = Install,Settings

[ucsschool-user-management/oauth/keycloak-uri]
Type = String
Description = Base URI of the Keycloak server for authentication. If unset the joinscript will attempt to set this value automatically.
Description[de] = URL des Keycloak-Servers zur Authentifizierung. Falls dieser Wert nicht gesetzt wird, versucht das Joinscript diesen Wert automatisch zu ermitteln.
Group = Authentication
Scope = outside
Show = Install,Settings

