[ucsschool-accounts/kelvin/url]
Type = String
Description = The hostname of the Kelvin REST API for data queries. If not set, the url is generated from hostname and domainname.
Description[de] = Der Hostname der Kelvin REST API, welche zum Abrufen von Daten genutzt wird. Wenn nicht gesetzt, wird die URL aus Hostname und Domainname generiert.
Group = Kelvin
Scope = outside
Show = Install,Settings

[ucsschool-accounts/oauth/keycloak-uri]
Type = String
Description = Base URI of the Keycloak server for authentication. If unset, the app uses the UCR variable keycloak/server/sso/fqdn, or ucs-sso-ng followed by the domain name.
Description[de] = Basis-URI des Keycloak-Servers zur Authentifizierung. Falls nicht gesetzt, verwendet die App die UCR-Variable keycloak/server/sso/fqdn oder ucs-sso-ng gefolgt vom Domainnamen.
Group = Authentication
Scope = outside
Show = Install,Settings

[ucsschool-accounts/logging/level]
Type = List
InitialValue = INFO
Values = TRACE, DEBUG, INFO, WARNING, ERROR, CRITICAL
Labels = TRACE, DEBUG, INFO, WARNING, ERROR, CRITICAL
Description = Sets the log level of the application.
Description[de] = Bestimmt das Loglevel der Applikation.
Group = Logging
Scope = outside
Show = Install,Settings

[ucsschool-accounts/logging/structured]
Type = Bool
InitialValue = false
Description = If set to True, each log record is written as a single JSON object. If set to False, the records follow the Univention log format.
Description[de] = Wird der Wert auf `True` gesetzt, wird jeder Logeintrag als einzelnes JSON-Objekt geschrieben. Bei `False` folgen die Einträge dem Univention-Logformat.
Group = Logging
Scope = outside
Show = Install,Settings
