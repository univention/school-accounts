###############################################################################
#                                                                             #
#  Dynamically generates the preinst file from templates.                     #
#                                                                             #
###############################################################################

preinst_TEMPLATE="templates/preinst.tmpl"
CONFIGURE_GUARDIAN_SCRIPT="scripts/configure_guardian.py"

cp $preinst_TEMPLATE preinst

sed -i -e "/%CONFIGURE-GUARDIAN%/r $CONFIGURE_GUARDIAN_SCRIPT" -e "/%CONFIGURE-GUARDIAN%/d" preinst

