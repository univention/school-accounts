###############################################################################
#                                                                             #
#  Dynamically generates the preinst file from templates.                     #
#                                                                             #
###############################################################################

PREINST_TEMPLATE="templates/preinst.tmpl"
FILES_DIR="files"
POLICIES_SOURCE_DIR="$FILES_DIR/policies"

cp $PREINST_TEMPLATE preinst

sed -i -e "/%UI_CLIENT%/r $FILES_DIR/ucsschool-accounts_client_ui.json" -e "/%UI_CLIENT%/d" preinst
sed -i -e "/%KELVIN_VERSION_CHECK%/r templates/check-kelvin-version.sh" -e "/%KELVIN_VERSION_CHECK%/d" preinst

# Generate one heredoc block per non-test policy YAML file (plain text, no
# tar/base64 involved), so a new policy file ships automatically without
# needing to be wired in here by name. Recurses to preserve the
# resource_policies/derived_roles split under files/policies/.
POLICIES_BLOCK="$(mktemp)"
trap 'rm -f "$POLICIES_BLOCK"' EXIT
while IFS= read -r policy_file; do
    base_name="$(basename "$policy_file")"
    case "$base_name" in
        *_test.yaml) continue ;;
    esac
    rel_path="${policy_file#"$POLICIES_SOURCE_DIR"/}"
    var_name="${base_name%.yaml}_yaml_path"
    {
        echo "mkdir -p \$POLICIES_DIR/$(dirname "$rel_path")"
        echo "${var_name}=\$POLICIES_DIR/$rel_path"
        echo "cat <<'%EOF' >\"\$${var_name}\""
        cat "$policy_file"
        echo "%EOF"
        echo "chmod 644 \$${var_name}"
        echo
    } >> "$POLICIES_BLOCK"
done < <(find "$POLICIES_SOURCE_DIR" -name '*.yaml' | sort)
sed -i -e "/%POLICIES%/r $POLICIES_BLOCK" -e "/%POLICIES%/d" preinst
