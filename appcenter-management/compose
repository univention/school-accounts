version: '3.1'
services:
  user-management-bff:
    image: gitregistry.knut.univention.de/univention/ucsschool-components/user-management/ucsschool-user-management-bff:latest
    security_opt:
      - seccomp:/etc/docker/seccomp-systemd.json
    restart: unless-stopped
    volumes:
      - /etc/ssl/certs:/etc/ssl/certs:ro
    environment:
      REQUESTS_CA_BUNDLE: /etc/ssl/certs/ca-certificates.crt
      SSL_CERT_FILE: /etc/ssl/certs/ca-certificates.crt
  user-management-ui:
    image: gitregistry.knut.univention.de/univention/ucsschool-components/user-management/ucsschool-user-management-ui:latest
    security_opt:
      - seccomp:/etc/docker/seccomp-systemd.json
    restart: unless-stopped
    volumes:
      - /etc/ssl/certs:/etc/ssl/certs:ro
    environment:
      SSL_CERT_FILE: /etc/ssl/certs/ca-certificates.crt
