## joinscript api: bindpwdfile

#
#  Join script that runs on the docker host.
#

# shellcheck disable=SC2034
VERSION=6

. /usr/share/univention-join/joinscripthelper.lib || exit 1
. /usr/share/univention-appcenter/joinscripthelper.sh || exit 1

APP_DIR="/var/lib/univention-appcenter/apps/$APP"
SCRIPTS_DIR="$APP_DIR/scripts"
CONF_DIR="$APP_DIR/conf"
ICON_DIR="/usr/share/univention-management-console-frontend/js/dijit/themes/umc/icons/scalable"

joinscript_init

eval "$(ucr shell hostname domainname ldap/base appcenter/apps/ucsschool-accounts/hostdn)"

univention-directory-manager portals/entry create "$@" --ignore_exists \
    --position "cn=entry,cn=portals,cn=univention,${ldap_base:?}" \
    --set name=$APP \
    --append displayName='"en_US" "School Accounts"' \
    --append displayName='"de_DE" "Schulzugänge"' \
    --append description='"en_US" "Administration of the UCS@school users with advanced permissions"' \
    --append description='"de_DE" "Verwaltung der UCS@school-Benutzer mit erweiterten Rechten"' \
    --append link='"en_US" "//'"${hostname:?}.${domainname:?}"'/univention/ucsschool/ucsschool-accounts/ui/"' \
    --set linkTarget=embedded || die

cat > "/etc/apache2/ucs-sites.conf.d/$APP.conf" <<'EOF' || die
# Written by the join script of the app ucsschool-accounts.
# Drops the "frame-ancestors 'none'" that univention.conf adds to every /univention/ response,
# so the portal can embed the app. The app sends its own frame-ancestors instead.
<Location "/univention/ucsschool/ucsschool-accounts/">
	Header always unset "Content-Security-Policy"
</Location>
EOF
systemctl reload apache2 || die

COMPONENT_ID="$(univention-app get "$APP" component_id | cut -f 2 -d ':' | tr -d '[:space:]')"
ICON_FILE="$ICON_DIR/apps-$COMPONENT_ID.svg"
if [ -f "$ICON_FILE" ]; then
    univention-directory-manager portals/entry modify "$@" --ignore_not_exists \
        --dn "cn=$APP,cn=entry,cn=portals,cn=univention,${ldap_base:?}" \
        --set icon="$(base64 -w0 "$ICON_FILE")" || die
fi

# New UCS@school RAM category
univention-directory-manager portals/category create "$@" --ignore_exists \
    --position "cn=category,cn=portals,cn=univention,$ldap_base" \
    --set name=ucsschool-ram \
    --append displayName='"en_US" "UCS@School Tech Preview"' \
    --append displayName='"de_DE" "UCS@School Technische Vorschau"' || die

univention-directory-manager portals/category modify "$@" \
    --dn "cn=ucsschool-ram,cn=category,cn=portals,cn=univention,${ldap_base:?}" \
    --append entries="cn=$APP,cn=entry,cn=portals,cn=univention,${ldap_base:?}" || die

univention-directory-manager portals/portal modify "$@" \
    --dn "cn=domain,cn=portal,cn=portals,cn=univention,$ldap_base" \
    --append categories="cn=ucsschool-ram,cn=category,cn=portals,cn=univention,${ldap_base:?}" || die

KELVIN_REST_GROUP_DN="cn=ucsschool-kelvin-rest-api-admins,cn=groups,$ldap_base"

echo "Adding School Accounts machine account '${appcenter_apps_ucsschool_accounts_hostdn:?}' to group 'ucsschool-kelvin-rest-api-admins'."
univention-directory-manager groups/group modify "$@" \
  --dn "$KELVIN_REST_GROUP_DN" \
  --append users="$appcenter_apps_ucsschool_accounts_hostdn" || die


keycloak_url=$(ucr get ucsschool-accounts/oauth/keycloak-uri)

if [ -z "$keycloak_url" ]
    then
    keycloak_url=$(ucr get keycloak/server/sso/fqdn)
fi

if [ -z "$keycloak_url" ]
    then
    keycloak_url="https://ucs-sso-ng.${domainname:?}"
elif ! [[ $keycloak_url == http* ]]
    then
    keycloak_url="https://$keycloak_url"
fi

# Checking the status of keycloak to be up, since otherwise the installation will fail.
echo "Checking Keycloak status..."

keycloak_response=$(curl --location --retry 20 --retry-delay 3 --write-out '%{http_code}' --silent --fail --output /dev/null "$keycloak_url"/realms/ucs/.well-known/openid-configuration)

if [ "$keycloak_response" -lt 200 ] || [ "$keycloak_response" -gt 299 ]; then
    echo "Keycloak is not responding. Exiting join script. Plase check your Keycloak installation."
    exit 2
else
    echo "Keycloak OK"
fi

# Register the Cerbos policy bundle in LDAP;
# Runs on every join (not gated by JS_LAST_EXECUTED_VERSION) so policy updates ship on every app update too.
# *_test.yaml files are already filtered in the preinst
POLICIES_DIR="$SCRIPTS_DIR/policies"
BUNDLE_TAR="$(mktemp --suffix=.tar)"
tar -C "$POLICIES_DIR" -cf "$BUNDLE_TAR" . || die

# VERSION as packageversion never needs a bump: an equal version still writes the new --data,
# only a strictly newer registered one is refused.
# Do not replace it with the app version: the UDM syntax is DebianPackageVersion.
. /usr/share/univention-lib/all.sh &&
ucs_registerLDAPExtension "$@" \
    --name ucsschool-accounts-policies \
    --packagename "$APP" \
    --packageversion "$VERSION" \
    --data "$BUNDLE_TAR" \
    --data_meta "{\"app\": \"$APP\", \"version\": \"$VERSION\"}" \
    --data_type "guardian/policy-bundle" || die

rm -f "$BUNDLE_TAR"

machine_username="$hostname$"
machine_pw="$(cat /etc/machine.secret)"

keycloak_provisioning () {
    univention-app shell "$APP" /venv/bin/keycloak-provisioning \
        --username "$machine_username" \
        --password "$machine_pw" \
        --url "$keycloak_url" \
        --realm ucs \
        --user-realm master \
        "$@"
}

# This client is used by the browser to authenticate against the app.
# Runs on every join, not only the first one, so that an update also reaches a
# client an earlier version registered as a public one.
keycloak_provisioning clients add "$CONF_DIR/ucsschool-accounts_client_ui.json" \
    --ignore-exists \
    --home-url "https://${hostname:?}.${domainname:?}/univention/ucsschool/ucsschool-accounts/" || die

# The client lives in the domain-wide `ucs` realm, so an earlier installation —
# a previous version here, or another host — may already have registered it, and
# every host that did authenticates with the secret Keycloak holds. Adopt that
# secret; registering the one the preinst generated would lock those hosts out.
CLIENT_SECRET_FILE="$CONF_DIR/client.secret"
registered_secret="$(keycloak_provisioning clients get-secret ucsschool-accounts-ui)" || die
registered_secret="${registered_secret//[[:space:]]/}"
adopted_secret=false
if [ -n "$registered_secret" ] && [ "$registered_secret" != "$(cat "$CLIENT_SECRET_FILE")" ]; then
    echo "Adopting the client secret already registered at Keycloak"
    printf '%s\n' "$registered_secret" > "$CLIENT_SECRET_FILE"
    adopted_secret=true
fi

keycloak_provisioning clients modify ucsschool-accounts-ui \
    --append-redirect-urls "https://${hostname:?}.${domainname:?}/univention/ucsschool/ucsschool-accounts/*" \
    --secret-file "$CLIENT_SECRET_FILE" || die

if [ "$adopted_secret" = true ]; then
    # entrypoint.d/10-copy-secrets.sh copied the generated secret into the
    # container at boot, which is before this script replaced the file.
    univention-app restart "$APP" || die
fi

joinscript_save_current_version

exit $?
