## joinscript api: bindpwdfile

#
#  Join script that runs on the docker host.
#

# shellcheck disable=SC2034
VERSION=2

APP_ID="ucsschool-user-management"
APP_DIR="/var/lib/univention-appcenter/apps/$APP_ID"
SCRIPTS_DIR="$APP_DIR/scripts"
CONDITION_DIR="$SCRIPTS_DIR/conditions"
CONF_DIR="$APP_DIR/conf"

. /usr/share/univention-join/joinscripthelper.lib || exit 1
. /usr/share/univention-appcenter/joinscripthelper.sh || exit 1

joinscript_init

eval "$(ucr shell hostname domainname ldap/base appcenter/apps/ucsschool-user-management/hostdn)"

univention-directory-manager portals/entry create "$@" --ignore_exists \
    --position "cn=entry,cn=portals,cn=univention,${ldap_base:?}" \
    --set name=$APP_ID \
    --append displayName='"en_US" "UCS@school User Management"' \
    --append displayName='"de_DE" "UCS@school Benutzerverwaltung"' \
    --append description='"en_US" "Administration of the UCS@school users with advanced permissions"' \
    --append description='"de_DE" "Verwaltung der UCS@school-Benutzer mit erweiterten Rechten"' \
    --append link='"en_US" "//'"${hostname:?}.${domainname:?}"'/univention/ucsschool/user-management/ui/"' \
    --append allowedGroups="cn=Domain Users,cn=groups,$ldap_base" \
    --set linkTarget=newwindow || die

# New UCS@school RAM category
univention-directory-manager portals/category create "$@" --ignore_exists \
    --position "cn=category,cn=portals,cn=univention,$ldap_base" \
    --set name=ucsschool-ram \
    --append displayName='"en_US" "UCS@School Tech Preview"' \
    --append displayName='"de_DE" "UCS@School Technische Vorschau"' || die

univention-directory-manager portals/category modify "$@" \
    --dn "cn=ucsschool-ram,cn=category,cn=portals,cn=univention,${ldap_base:?}" \
    --append entries="cn=$APP_ID,cn=entry,cn=portals,cn=univention,${ldap_base:?}" || die

univention-directory-manager portals/portal modify "$@" \
    --dn "cn=domain,cn=portal,cn=portals,cn=univention,$ldap_base" \
    --append categories="cn=ucsschool-ram,cn=category,cn=portals,cn=univention,${ldap_base:?}" || die

KELVIN_REST_GROUP_DN="cn=ucsschool-kelvin-rest-api-admins,cn=groups,$ldap_base"

echo "Adding UCS@school User Management machine account '${appcenter_apps_ucsschool_user_management_hostdn:?}' to group 'ucsschool-kelvin-rest-api-admins'."
univention-directory-manager groups/group modify "$@" \
  --dn "$KELVIN_REST_GROUP_DN" \
  --append users="$appcenter_apps_ucsschool_user_management_hostdn" || die


keycloak_url=$(ucr get keycloak/server/sso/fqdn)

if [ -z "$keycloak_url" ]
    then
    keycloak_url="https://ucs-sso-ng.${domainname:?}"
elif ! [[ $keycloak_url == http* ]]
    then
    keycloak_url="https://$keycloak_url"
fi

# Checking the status of keycloak to be up, since otherwise the installation will fail.
echo "Checking Keycloak status..."

keycloak_response=$(curl --location --retry 20 --retry-delay 3 --write-out '%{http_code}' --silent --fail --output /dev/null "$keycloak_url"/realms/ucs/.well-known/openid-configuration)

if [ "$keycloak_response" -lt 200 ] || [ "$keycloak_response" -gt 299 ]; then
    echo "Keycloak is not responding. Exiting join script. Plase check your Keycloak installation."
    exit 2
else
    echo "Keycloak OK"
fi

# Create temporary user for guardian administration.
SYS_USER_PW=$(openssl rand -base64 24)
SYS_USER_NAME="ucsschool-user-management-sys-user-$(date +%s)"
udm users/user create "$@" \
  --position "cn=users,$ldap_base" \
  --set guardianRoles="guardian:builtin:super-admin" \
  --set username="$SYS_USER_NAME" \
  --set lastname="Sysuser" \
  --set password="$SYS_USER_PW" || die

# shellcheck disable=SC2317
cleanup_sys_user() {
    udm users/user remove "$@" --dn "uid=$SYS_USER_NAME,cn=users,$ldap_base" || die
}
trap cleanup_sys_user SIGINT SIGTERM ERR EXIT

guardian_management_api_url="https://$(univention-ldapsearch "(univentionService=guardian-management-api)" cn | grep -Po '(?<=^cn: )[^,]*' | head -1).$domainname/guardian/management"
echo "Configuring Guardian objects at $guardian_management_api_url"
$SCRIPTS_DIR/configure_guardian.py \
    "$guardian_management_api_url" \
    "$SYS_USER_NAME" \
    "$SYS_USER_PW" \
    "$keycloak_url/realms/ucs/protocol/openid-connect/token" \
    guardian-scripts \
    $CONDITION_DIR || die

if [ "$JS_LAST_EXECUTED_VERSION" -lt 1 ]; then

  machine_username="$hostname$"
  machine_pw="$(cat /etc/machine.secret)"

  # This client is used by the frontend to communicate with the bff
  univention-app shell "$APP_ID" /usr/local/bin/keycloak-provisioning \
      --username "$machine_username" \
      --password "$machine_pw" \
      --url "$keycloak_url" \
      --realm ucs \
      --user-realm master \
      clients add "$CONF_DIR/ucsschool-user-management_client_ui.json" \
      --ignore-exists \
      --home-url "https://${hostname:?}.${domainname:?}/univention/ucsschool/user-management/" || die

  univention-app shell "$APP_ID" /usr/local/bin/keycloak-provisioning \
      --username "$machine_username" \
      --password "$machine_pw" \
      --url "$keycloak_url" \
      --realm ucs \
      --user-realm master \
      clients modify ucsschool-user-management-ui \
      --append-redirect-urls "https://${hostname:?}.${domainname:?}/univention/ucsschool/user-management/*" || die

  # This client is used by the bff to communicate with the guardian
  univention-app shell "$APP_ID" /usr/local/bin/keycloak-provisioning \
      --username "$machine_username" \
      --password "$machine_pw" \
      --url "$keycloak_url" \
      --realm ucs \
      --user-realm master \
      clients add "$CONF_DIR/ucsschool-user-management_client_bff.json" \
      --ignore-exists \
      --create-secret \
      --home-url "https://${hostname:?}.${domainname:?}/univention/ucsschool/user-management/bff" || die

  SECRET=$(univention-app shell "$APP_ID" /usr/local/bin/keycloak-provisioning \
      --username "$machine_username" \
      --password "$machine_pw" \
      --url "$keycloak_url" \
      --realm ucs \
      --user-realm master \
      clients get-secret ucsschool-user-management-bff) || die
  echo "$SECRET" > "$CONF_DIR/client.secret"

  guardian_authorization_api_url="https://$(univention-ldapsearch "$@" "(univentionService=guardian-authorization-api)" cn | grep -Po '(?<=^cn: )[^,]*' | head -1).$domainname/guardian/authorization"

  univention-app configure $APP_ID --set ucsschool-user-management/guardian/client_secret="$SECRET" \
                                         ucsschool-user-management/guardian/url="$guardian_authorization_api_url" || die

fi

joinscript_save_current_version

exit $?
