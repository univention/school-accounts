# Overrides for `dev/dev_run.sh task kelvin-server`, layered on top of dev/.env.
# Everything that has a Kelvin implementation reads from a real environment, the
# permission checks go to the Cerbos container running the real policies, and
# there is no interactive login - so the UI answers a plain curl and a page can
# be timed against data the file adapters cannot imitate.

USER_MANAGEMENT__ADAPTER__USERS_PERSISTENCE="user_management_bff.adapters.users:KelvinUsersPersistenceAdapter"
USER_MANAGEMENT__ADAPTER__SCHOOLS_PERSISTENCE="user_management_bff.adapters.schools:KelvinSchoolsPersistenceAdapter"
USER_MANAGEMENT__ADAPTER__SCHOOL_CLASSES_PERSISTENCE="user_management_bff.adapters.school_classes:KelvinSchoolClassesPersistenceAdapter"
USER_MANAGEMENT__ADAPTER__WORK_GROUPS_PERSISTENCE="user_management_bff.adapters.work_groups:KelvinWorkGroupsPersistenceAdapter"

# dev_run.sh reads this one itself, to resolve the name for the container and to
# fetch the CA of the instance it names.
KELVIN_PERSISTENCE_ADAPTER__URL=primary.ucsschool.test
KELVIN_PERSISTENCE_ADAPTER__USERNAME=Administrator
KELVIN_PERSISTENCE_ADAPTER__PASSWORD=univention

USER_MANAGEMENT__ADAPTER__PERMISSIONS="user_management_bff.adapters.permissions:CerbosPermissionsAdapter"
CERBOS_PERMISSIONS_ADAPTER__CERBOS_TARGET="cerbos:3593"
# The local Cerbos container does not terminate TLS, and gRPC defaults to secure.
CERBOS_PERMISSIONS_ADAPTER__TLS_VERIFY="false"

# Every request is this actor. It has to be a UCS@school user that exists in the
# environment above - Administrator is not one, and the page answers with
# "not a valid UCS@school user" if it is left here.
USER_MANAGEMENT__ADAPTER__AUTHENTICATION="user_management_bff.adapters.authentication:AlwaysAuthenticatedAdapter"
ALWAYS_AUTHENTICATED_ADAPTER__ACTOR_ID=demo_teacher

# Written by dev/scripts/fetch_ucs_ca.sh, which dev_run.sh runs when the bundle
# is missing. These replace the trust store rather than adding to it, so it is
# the merged bundle, never the UCS root on its own.
REQUESTS_CA_BUNDLE=/src/dev/local/ca-bundle.crt
SSL_CERT_FILE=/src/dev/local/ca-bundle.crt

# Every Kelvin and Cerbos call the request makes is logged at this level.
USER_MANAGEMENT__LOGGING__LEVEL="DEBUG"
