USER_MANAGEMENT__API_PREFIX=/univention/ucsschool/user-management/bff
USER_MANAGEMENT__CORS__ALLOWED_ORIGINS=*
USER_MANAGEMENT__ADAPTER__USERS_PERSISTENCE="user_management_bff.adapters.users:FileUsersPersistenceAdapter"
USER_MANAGEMENT__ADAPTER__SCHOOLS_PERSISTENCE="user_management_bff.adapters.schools:FileSchoolsPersistenceAdapter"
USER_MANAGEMENT__ADAPTER__SCHOOL_CLASSES_PERSISTENCE="user_management_bff.adapters.school_classes:FileSchoolClassesPersistenceAdapter"
USER_MANAGEMENT__ADAPTER__WORK_GROUPS_PERSISTENCE="user_management_bff.adapters.work_groups:FileWorkGroupsPersistenceAdapter"
USER_MANAGEMENT__ADAPTER__AUTHENTICATION="user_management_bff.adapters.authentication:CookieSessionAuthenticationAdapter"
# To skip the interactive Keycloak login (e.g. manual testing against a real
# Kelvin/Cerbos backend), swap in the always-authenticated dev/test double instead
# and pick which actor every request is treated as (defaults to "dev" if unset):
# USER_MANAGEMENT__ADAPTER__AUTHENTICATION="user_management_bff.adapters.authentication:AlwaysAuthenticatedAdapter"
# ALWAYS_AUTHENTICATED_ADAPTER__ACTOR_ID="demo_teacher"
USER_MANAGEMENT__ADAPTER__PERMISSIONS="user_management_bff.adapters.permissions:FilePermissionsAdapter"
# Interactive browser login (confidential `-ui` client, auth code + PKCE).
COOKIE_SESSION_AUTHENTICATION_ADAPTER__WELL_KNOWN_URL="http://user-management-proxy/keycloak/realms/ucs/.well-known/openid-configuration"
COOKIE_SESSION_AUTHENTICATION_ADAPTER__CLIENT_ID="ucsschool-user-management-ui"
# The same file provision_keycloak.sh registers the client secret from. In a
# deployment this is the generated /run/secrets/client.secret.
COOKIE_SESSION_AUTHENTICATION_ADAPTER__CLIENT_SECRET_FILE="/src/dev/data/client.secret"
COOKIE_SESSION_AUTHENTICATION_ADAPTER__REDIRECT_URL="http://user-management-proxy/univention/ucsschool/user-management/ui/auth/callback"
COOKIE_SESSION_AUTHENTICATION_ADAPTER__POST_LOGOUT_REDIRECT_URL="http://user-management-proxy/univention/ucsschool/user-management/ui"
COOKIE_SESSION_AUTHENTICATION_ADAPTER__IDENTIFIER_CLAIM="preferred_username"
# COOKIE_SESSION_AUTHENTICATION_ADAPTER__DISPLAY_NAME_CLAIM="name"
# In a deployment this is the generated /run/secrets/session.secret.
COOKIE_SESSION_AUTHENTICATION_ADAPTER__COOKIE_SECRET="dev-cookie-secret-change-me"
# Local dev is served over plain HTTP, so don't require the Secure flag.
COOKIE_SESSION_AUTHENTICATION_ADAPTER__COOKIE_SECURE="false"
USER_MANAGEMENT__SESSION_SECRET="dev-session-secret-change-me"
USER_MANAGEMENT__SESSION_COOKIE_SECURE="false"
# Bounds how many concurrent set_password calls a bulk password reset has in
# flight against the persistence adapter at once. 5 is the app default;
# uncomment/adjust only if a deployment's Kelvin backend needs a different bound.
# USER_MANAGEMENT__PASSWORD_RESET_MAX_CONCURRENCY="5"
# Rejects a bulk password reset outright once the (deduplicated) selection
# exceeds this many users, since the request is a single synchronous call with
# no background job. 200 is the app default; uncomment/adjust if needed.
# USER_MANAGEMENT__PASSWORD_RESET_MAX_TARGETS="200"
FILE_USERS_PERSISTENCE_ADAPTER__SOURCE="/src/dev/data/users.json"
FILE_SCHOOLS_PERSISTENCE_ADAPTER__SOURCE="/src/dev/data/schools.json"
FILE_SCHOOL_CLASSES_PERSISTENCE_ADAPTER__SOURCE="/src/dev/data/school_classes.json"
FILE_WORK_GROUPS_PERSISTENCE_ADAPTER__SOURCE="/src/dev/data/work_groups.json"
FILE_PERMISSIONS_ADAPTER__SOURCE="/src/dev/data/permissions.json"

USER_MANAGEMENT__LOGGING__LEVEL="INFO"
USER_MANAGEMENT__LOGGING__STRUCTURED="0"
USER_MANAGEMENT__LOGGING__BACKTRACE="0"
USER_MANAGEMENT__LOGGING__DIAGNOSE="0"

# To use Kelvin as the User Persistence Adapter uncomment the following lines
# USER_MANAGEMENT__ADAPTER__USERS_PERSISTENCE="user_management_bff.adapters.users:KelvinUsersPersistenceAdapter"
# USER_MANAGEMENT__ADAPTER__SCHOOLS_PERSISTENCE="user_management_bff.adapters.schools:KelvinSchoolsPersistenceAdapter"
# USER_MANAGEMENT__ADAPTER__SCHOOL_CLASSES_PERSISTENCE="user_management_bff.adapters.school_classes:KelvinSchoolClassesPersistenceAdapter"
# USER_MANAGEMENT__ADAPTER__WORK_GROUPS_PERSISTENCE="user_management_bff.adapters.work_groups:KelvinWorkGroupsPersistenceAdapter"
# KELVIN_PERSISTENCE_ADAPTER__URL=backup1.ucsschool.test
# KELVIN_PERSISTENCE_ADAPTER__USERNAME=Administrator
# KELVIN_PERSISTENCE_ADAPTER__PASSWORD=univention
# These two replace the trust store instead of adding to it, so they point at the merged
# bundle `dev/scripts/fetch_ucs_ca.sh` writes, never at the UCS root on its own -- that
# would leave the process unable to verify PyPI.
# REQUESTS_CA_BUNDLE=/src/dev/local/ca-bundle.crt
# SSL_CERT_FILE=/src/dev/local/ca-bundle.crt

# To use Cerbos for permissions, uncomment the following lines.
# USER_MANAGEMENT__ADAPTER__PERMISSIONS="user_management_bff.adapters.permissions:CerbosPermissionsAdapter"
# CERBOS_PERMISSIONS_ADAPTER__CERBOS_TARGET="cerbos:3593"
# Unlike the old HTTP client, where "http://" already forced plaintext, gRPC's channel-security
# flag defaults to secure - but the local Cerbos container doesn't terminate TLS, so disable the
# handshake explicitly.
# CERBOS_PERMISSIONS_ADAPTER__TLS_VERIFY="false"
# Cerbos rejects a CheckResources call whose batch exceeds the server's own configured
# per-request resource limit. 50 is this deployment's current limit and the adapter's
# default; uncomment/adjust only if the Cerbos server's limit differs.
# CERBOS_PERMISSIONS_ADAPTER__MAX_BATCH_SIZE="50"
# These two replace the trust store instead of adding to it, so they point at the merged
# bundle `dev/scripts/fetch_ucs_ca.sh` writes, never at the UCS root on its own -- that
# would leave the process unable to verify PyPI.
# REQUESTS_CA_BUNDLE=/src/dev/local/ca-bundle.crt
# SSL_CERT_FILE=/src/dev/local/ca-bundle.crt

# Uncomment to run the integration tests locally against the integration test environment
# OAUTH2_FASTAPI_AUTHENTICATION_ADAPTER__WELL_KNOWN_URL="https://ucs-sso-ng.ucsschool.test/realms/ucs/.well-known/openid-configuration"
# USER_MANAGEMENT__ADAPTER__USERS_PERSISTENCE="user_management_bff.adapters.users:KelvinUsersPersistenceAdapter"
# USER_MANAGEMENT__ADAPTER__SCHOOLS_PERSISTENCE="user_management_bff.adapters.schools:KelvinSchoolsPersistenceAdapter"
# USER_MANAGEMENT__ADAPTER__SCHOOL_CLASSES_PERSISTENCE="user_management_bff.adapters.school_classes:KelvinSchoolClassesPersistenceAdapter"
# USER_MANAGEMENT__ADAPTER__WORK_GROUPS_PERSISTENCE="user_management_bff.adapters.work_groups:KelvinWorkGroupsPersistenceAdapter"
# KELVIN_PERSISTENCE_ADAPTER__URL=primary.ucsschool.test
# KELVIN_PERSISTENCE_ADAPTER__USERNAME=Administrator
# KELVIN_PERSISTENCE_ADAPTER__PASSWORD=univention
# USER_MANAGEMENT__ADAPTER__PERMISSIONS="user_management_bff.adapters.permissions:CerbosPermissionsAdapter"
# CERBOS_PERMISSIONS_ADAPTER__CERBOS_TARGET="cerbos:3593"
# Unlike the old HTTP client, where "http://" already forced plaintext, gRPC's channel-security
# flag defaults to secure - but the local Cerbos container doesn't terminate TLS, so disable the
# handshake explicitly.
# CERBOS_PERMISSIONS_ADAPTER__TLS_VERIFY="false"
# Cerbos rejects a CheckResources call whose batch exceeds the server's own configured
# per-request resource limit. 50 is this deployment's current limit and the adapter's
# default; uncomment/adjust only if the Cerbos server's limit differs.
# CERBOS_PERMISSIONS_ADAPTER__MAX_BATCH_SIZE="50"
# These two replace the trust store instead of adding to it, so they point at the merged
# bundle `dev/scripts/fetch_ucs_ca.sh` writes, never at the UCS root on its own -- that
# would leave the process unable to verify PyPI.
# REQUESTS_CA_BUNDLE=/src/dev/local/ca-bundle.crt
# SSL_CERT_FILE=/src/dev/local/ca-bundle.crt
