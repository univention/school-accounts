USER_MANAGEMENT__API_PREFIX=/univention/ucsschool/user-management/bff
USER_MANAGEMENT__CORS__ALLOWED_ORIGINS=*
USER_MANAGEMENT__ADAPTER__USERS_PERSISTENCE="user_management_bff.adapters.users:FileUsersPersistenceAdapter"
USER_MANAGEMENT__ADAPTER__USERS_REPRESENTATION="user_management_bff.adapters.api:FastAPIUsersRepresentationAdapter"
USER_MANAGEMENT__ADAPTER__SCHOOLS_PERSISTENCE="user_management_bff.adapters.schools:FileSchoolsPersistenceAdapter"
USER_MANAGEMENT__ADAPTER__SCHOOLS_REPRESENTATION="user_management_bff.adapters.api:FastAPISchoolsRepresentationAdapter"
USER_MANAGEMENT__ADAPTER__AUTHENTICATION="user_management_bff.adapters.authentication:Oauth2FastAPIAuthenticationAdapter"
USER_MANAGEMENT__ADAPTER__PERMISSIONS="user_management_bff.adapters.permissions:FilePermissionsAdapter"
OAUTH2_FASTAPI_AUTHENTICATION_ADAPTER__WELL_KNOWN_URL="http://user-management-proxy/keycloak/realms/ucs/.well-known/openid-configuration"
OAUTH2_FASTAPI_AUTHENTICATION_ADAPTER__AUDIENCE="ucsschool-user-management"
OAUTH2_FASTAPI_AUTHENTICATION_ADAPTER__IDENTIFIER_CLAIM="preferred_username"
FILE_USERS_PERSISTENCE_ADAPTER__SOURCE="/src/dev/data/users.json"
FILE_SCHOOLS_PERSISTENCE_ADAPTER__SOURCE="/src/dev/data/schools.json"
FILE_PERMISSIONS_ADAPTER__SOURCE="/src/dev/data/permissions.json"

# To use Kelvin as the User Persistence Adapter uncomment the following lines
# USER_MANAGEMENT__ADAPTER__USERS_PERSISTENCE="user_management_bff.adapters.users:KelvinUsersPersistenceAdapter"
# USER_MANAGEMENT__ADAPTER__SCHOOLS_PERSISTENCE="user_management_bff.adapters.schools:KelvinSchoolsPersistenceAdapter"
# KELVIN_PERSISTENCE_ADAPTER__URL=backup1.school.test
# KELVIN_PERSISTENCE_ADAPTER__USERNAME=Administrator
# KELVIN_PERSISTENCE_ADAPTER__PASSWORD=univention
# REQUESTS_CA_BUNDLE=/src/dev/local/ucs-root-ca.crt
# SSL_CERT_FILE=/src/dev/local/ucs-root-ca.crt

# To use the Guardian for permissions, uncomment the following lines.
# USER_MANAGEMENT__ADAPTER__PERMISSIONS="user_management_bff.adapters.permissions:GuardianPermissionsAdapter"
# GUARDIAN_PERMISSIONS_ADAPTER__OAUTH2_WELL_KNOWN_URL="https://ucs-sso-ng.school.test/realms/ucs/.well-known/openid-configuration"
# GUARDIAN_PERMISSIONS_ADAPTER__GUARDIAN_URL="https://backup1.school.test/guardian/authorization/"
# GUARDIAN_PERMISSIONS_ADAPTER__CLIENT_ID="ucsschool-user-management-bff"
# GUARDIAN_PERMISSIONS_ADAPTER__CLIENT_SECRET="secret"
# REQUESTS_CA_BUNDLE=/src/dev/local/ucs-root-ca.crt
# SSL_CERT_FILE=/src/dev/local/ucs-root-ca.crt

VITE__USER_MANAGEMENT_UI__ADAPTER__SETTINGS_PORT=env
VITE__USER_MANAGEMENT_UI__ADAPTER__DATA_PORT=api
VITE__API_DATA_ADAPTER__URI=/univention/ucsschool/user-management/bff

# Uncomment to run the integration tests locally against the integration test environment
# OAUTH2_FASTAPI_AUTHENTICATION_ADAPTER__WELL_KNOWN_URL="https://ucs-sso-ng.school.test/realms/ucs/.well-known/openid-configuration"
# USER_MANAGEMENT__ADAPTER__USERS_PERSISTENCE="user_management_bff.adapters.users:KelvinUsersPersistenceAdapter"
# USER_MANAGEMENT__ADAPTER__SCHOOLS_PERSISTENCE="user_management_bff.adapters.schools:KelvinSchoolsPersistenceAdapter"
# KELVIN_PERSISTENCE_ADAPTER__URL=backup1.school.test
# KELVIN_PERSISTENCE_ADAPTER__USERNAME=Administrator
# KELVIN_PERSISTENCE_ADAPTER__PASSWORD=univention
# USER_MANAGEMENT__ADAPTER__PERMISSIONS="user_management_bff.adapters.permissions:GuardianPermissionsAdapter"
# GUARDIAN_PERMISSIONS_ADAPTER__OAUTH2_WELL_KNOWN_URL="https://ucs-sso-ng.school.test/realms/ucs/.well-known/openid-configuration"
# GUARDIAN_PERMISSIONS_ADAPTER__GUARDIAN_URL="https://backup1.school.test/guardian/authorization/"
# GUARDIAN_PERMISSIONS_ADAPTER__CLIENT_ID="ucsschool-user-management-test"
# GUARDIAN_PERMISSIONS_ADAPTER__CLIENT_SECRET="univention"
# REQUESTS_CA_BUNDLE=/src/dev/local/ucs-root-ca.crt
# SSL_CERT_FILE=/src/dev/local/ucs-root-ca.crt